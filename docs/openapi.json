{
  "openapi": "3.0.3",
  "info": {
    "title": "HIMS Supply Chain API",
    "version": "1.1.0",
    "description": "Machine-readable core authentication and inventory-item contract. The complete 76-route endpoint, permission, validation, response, and verification catalog is linked as external documentation. Operational routes accept stateful Sanctum sessions; bearer-token access is available only when the HIMS single-device policy is disabled."
  },
  "externalDocs": {
    "description": "Complete HIMS API integration documentation and evidence",
    "url": "./evidence/api-integration/README.md"
  },
  "servers": [{"url": "/", "description": "Current HIMS deployment"}],
  "paths": {
    "/api/v1/auth/token": {
      "post": {
        "summary": "Issue a Sanctum personal access token",
        "description": "Unavailable while single-device security is enabled. Super Administrator accounts are excluded. Progressive login lockout, MFA, and password-expiration policy apply.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {"type": "string", "format": "email", "example": "api.user@example.test"},
                  "password": {"type": "string", "format": "password", "writeOnly": true, "example": "Example-only-password"},
                  "device_name": {"type": "string", "maxLength": 255, "nullable": true, "example": "integration-client"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued",
            "content": {"application/json": {"schema": {"type": "object", "required": ["token"], "properties": {"token": {"type": "string", "writeOnly": true}}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "428": {"description": "Device security, MFA verification, or password renewal requires the matching HIMS web login panel", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
          "429": {
            "description": "Progressive login wait or temporary account lock",
            "headers": {"Retry-After": {"description": "Seconds until another attempt is allowed", "schema": {"type": "integer", "minimum": 1}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoke the current personal access token",
        "description": "Bearer-token-only endpoint. Stateful browser sessions use the panel web logout route.",
        "security": [{"bearerAuth": []}],
        "responses": {
          "204": {"description": "Current token revoked"},
          "400": {"description": "The authenticated request used a stateful session instead of a personal access token", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
          "401": {"$ref": "#/components/responses/Unauthenticated"}
        }
      }
    },
    "/api/v1/inventory-items": {
      "get": {
        "summary": "List inventory items",
        "description": "Requires view_inventory. Financial and supplier fields are conditionally omitted based on the caller's permissions.",
        "security": [{"cookieAuth": []}, {"bearerAuth": []}],
        "parameters": [{"name": "per_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 15}}],
        "responses": {
          "200": {"description": "Paginated inventory-item collection"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "500": {"$ref": "#/components/responses/UnexpectedError"}
        }
      },
      "post": {
        "summary": "Create an inventory item",
        "description": "Requires manage_items.",
        "security": [{"cookieAuth": []}, {"bearerAuth": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/InventoryItemWrite"}, {"type": "object", "required": ["sku", "name"]}]}}}},
        "responses": {
          "201": {"description": "Inventory item created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InventoryItemEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "500": {"$ref": "#/components/responses/UnexpectedError"}
        }
      }
    },
    "/api/v1/inventory-items/{inventory_item}": {
      "parameters": [{"name": "inventory_item", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}],
      "get": {
        "summary": "Read an inventory item",
        "description": "Requires view_inventory.",
        "security": [{"cookieAuth": []}, {"bearerAuth": []}],
        "responses": {
          "200": {"description": "Inventory item", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InventoryItemEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      },
      "patch": {
        "summary": "Partially update an inventory item",
        "description": "Requires manage_items. PUT is also registered with the same behavior.",
        "security": [{"cookieAuth": []}, {"bearerAuth": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InventoryItemWrite"}}}},
        "responses": {
          "200": {"description": "Inventory item updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InventoryItemEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {"type": "apiKey", "in": "cookie", "name": "laravel_session", "description": "Stateful Sanctum browser session; unsafe requests also require the XSRF token."},
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "Sanctum personal access token"}
    },
    "schemas": {
      "Message": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string"}, "code": {"type": "string"}}},
      "InventoryItemWrite": {
        "type": "object",
        "properties": {
          "sku": {"type": "string"},
          "name": {"type": "string", "maxLength": 255},
          "barcode_value": {"type": "string", "maxLength": 100, "nullable": true},
          "gtin": {"type": "string", "minLength": 8, "maxLength": 14, "nullable": true},
          "unit": {"type": "string", "nullable": true},
          "unit_cost": {"type": "number", "minimum": 0, "maximum": 9999999999.99, "nullable": true},
          "reorder_level": {"type": "integer", "minimum": 0, "nullable": true},
          "supplier_id": {"type": "integer", "nullable": true, "description": "Must identify a procurement-eligible supplier."},
          "status": {"type": "string", "enum": ["active", "inactive"], "nullable": true},
          "is_batch_tracked": {"type": "boolean"},
          "is_serial_tracked": {"type": "boolean"},
          "is_expiry_tracked": {"type": "boolean"}
        }
      },
      "InventoryItem": {
        "allOf": [
          {"$ref": "#/components/schemas/InventoryItemWrite"},
          {"type": "object", "required": ["id", "stock_status"], "properties": {"id": {"type": "integer"}, "stock_status": {"type": "string"}}}
        ]
      },
      "InventoryItemEnvelope": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/InventoryItem"}}},
      "ValidationError": {
        "type": "object",
        "required": ["message", "errors"],
        "properties": {
          "message": {"type": "string", "example": "The given data was invalid."},
          "errors": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
        }
      },
      "UnexpectedError": {
        "type": "object",
        "required": ["success", "message", "error_id"],
        "properties": {
          "success": {"type": "boolean", "example": false},
          "message": {"type": "string", "example": "An unexpected system error occurred. Operations were safely aborted."},
          "error_id": {"type": "string", "example": "REC-EXAMPLE"}
        }
      }
    },
    "responses": {
      "Unauthenticated": {"description": "Authentication required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
      "Forbidden": {"description": "Authenticated caller lacks the required permission", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
      "NotFound": {"description": "Resource or route not found; implementation details are redacted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}, "example": {"message": "Not Found"}}}},
      "ValidationError": {"description": "Request validation or domain-rule failure", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ValidationError"}}}},
      "UnexpectedError": {"description": "Unexpected server failure with safe correlation ID", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UnexpectedError"}}}}
    }
  }
}
